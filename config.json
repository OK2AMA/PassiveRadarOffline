{
  "dataset": {
    "dir": "IQ",
    "channel_a_file": "Ch1_Fc514MHz_Fs3MHz_DVBT",
    "channel_b_file": "Ch2_Fc514MHz_Fs3MHz_DVBT",
    "fs_hz": 3000000,
    "fc_hz": 514000000.0,
    "cpi_seconds": 1.0,
    "offset_samples": 0
