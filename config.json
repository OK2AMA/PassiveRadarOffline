    "guard_cells": [2, 4],
    "ref_cells": [8, 16],
    "snr_threshold_db": 12.0,
    "exclude_zero_doppler_hz": 15.0
  },
  "visualization": {
    "save_plots": true,
    "output_dir": "output_plots",
    "show_plots": false
  }
